root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4

[*.{js,ts,jsx,tsx,vue,json,css,scss,less,html,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{xml,sql}]
indent_size = 2

[Makefile]
indent_style = tab
